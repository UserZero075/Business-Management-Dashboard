{
  "name": "devfast-manager-backend",
  "version": "1.1.0",
  "description": "API do sistema de gestão DevFast",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "reset:operational-data": "tsx src/scripts/resetOperationalData.ts",
    "reset:operational-data:dist": "node dist/scripts/resetOperationalData.js",
    "normalize:brazil-dates": "tsx src/scripts/normalizeBrazilDates.ts",
    "normalize:brazil-dates:dist": "node dist/scripts/normalizeBrazilDates.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.0",
    "@fastify/websocket": "^8.3.1",
    "@prisma/client": "^5.10.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.0.0-rc.12",
    "fastify": "^4.26.0",
    "node-cron": "^3.0.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^20.11.0",
    "prisma": "^5.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
